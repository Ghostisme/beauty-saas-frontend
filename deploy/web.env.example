# ═══════════════════════════════════════════════════════════════════════
#  前端环境变量模板  →  /opt/beauty-saas/web.env
#
#  这份文件里**没有任何密钥**，这是前后端拆流水线顺带拿到的安全收益：
#  beauty-web 那条流水线只读这一份，整条前端链路接触不到 JWT 密钥和
#  数据库密码（那些在 server.env 里，只有 beauty-api 读）。
#
#  权限可以宽一些：chmod 640。
#
#  ⚠️ 本项目前端**没有任何构建期变量**：API 地址写死成同源的 `/api`
#     （见 src/lib/request.ts）。所以换域名不需要重新打包前端，
#     只改宿主机 nginx 配置即可 —— 这和参考架构里 lumax / agent-studio
#     那几个用 VITE_* / NEXT_PUBLIC_* 的项目不同，它们改域名必须
#     勾 FORCE_REBUILD 重新打包。
#
#     这里保留这个文件只为两点：
#       1. compose 的 --env-file 需要一个存在的文件；
#       2. 给 IMAGE_TAG 之类的部署期变量留位置。
# ═══════════════════════════════════════════════════════════════════════

# 站点域名。当前仅作记录用途，不参与构建也不注入容器 ——
# 真正决定站点域名的是 /etc/nginx/conf.d/20-beauty.conf 里的 server_name。
BEAUTY_SITE_DOMAIN=beauty.darkrich.com
